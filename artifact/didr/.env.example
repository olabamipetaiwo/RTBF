# Copy to .env and adjust if needed. All settings are optional.
# Nothing account-specific goes here: log in with `python login_setup.py <agent>`.

# Workbook the pipeline reads test cases from and writes results to.
# DIDR_WORKBOOK=data/DIDR Test Cases.xlsx

# Where saved login sessions and evidence (transcripts, screenshots) go.
# DIDR_SESSIONS_DIR=sessions
# DIDR_RESULTS_DIR=results

# 1 runs the browser headless. Several agents block headless browsers, so the
# default is a visible browser window.
# DIDR_HEADLESS=0
