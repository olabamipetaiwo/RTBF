{"kind":"textbox","id":"sh/2xk3u9wv","slideIndex":5,"position":{"left":415,"top":175,"width":1105,"height":143.6},"text":"A typed request did not reliably remove the fact (31 of 133 came back; in 97 of the other 102 it refused, citing the request), while deleting a thread or all threads held where an outcome is known.","geometry":"rect","lineWidth":0,"style":{"fontSize":30,"typeface":"Arial","color":"#222222","alignment":"left"}}
{"kind":"textbox","id":"sh/nytk3edg","slideIndex":5,"position":{"left":80,"top":328.6,"width":310,"height":106.6},"text":"Why","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Arial","color":"#555555","bold":true,"alignment":"left"}}
