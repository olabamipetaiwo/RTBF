{"kind":"textbox","id":"sh/p8zqx8vy","slideIndex":2,"position":{"left":1450,"top":840,"width":70,"height":30},"text":"02","geometry":"rect","lineWidth":0,"style":{"fontSize":20,"typeface":"Arial","color":"#777777","alignment":"left"}}
