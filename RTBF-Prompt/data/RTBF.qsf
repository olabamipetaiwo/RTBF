Desc\">I have never deleted my data in AI Chatbots<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"Some laws give people the right to request that companies delete their personal data. This is som...","TertiaryAttribute":null,"Payload":{"Selector":"SAVR","DataExportTag":"Q7","QuestionText":"Some laws give people the right to request that companies delete their personal data. This is sometimes called the Right to Be Forgotten (RTBF), recognised under GDPR (Europe) and CCPA (California). Were you aware that this right exists?","QuestionDescription":"Some laws give people the right to request that companies delete their personal data. This is som...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID9","QuestionText_Unsafe":"Some laws give people the right to request that companies delete their personal data. This is sometimes called the Right to Be Forgotten (RTBF), recognised under GDPR (Europe) and CCPA (California). Were you aware that this right exists?","SubSelector":"TX","Choices":{"1":{"Display":"Yes, I was fully aware"},"2":{"Display":"I had heard of it but did not know the details"},"3":{"Display":"No, I was not aware"}},"ChoiceOrder":["1","2","3"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID90","SecondaryAttribute":"Which of the data deletion methods you have never used before would you use to delete your locati...","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of the data deletion methods you have never used before would you use to delete your location data in the scenario?<br>\n<span style=\"font-size:11px;\">Please do not include any personally identifiable information (such as your name, email address, or account details) in your response<\/span>","DataExportTag":"Q4.13","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of the data deletion methods you have never used before would you use to delete your locati...","Choices":{"1":{"Display":"None of above would work, I have another method (Please specify):","TextEntry":"true"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":2,"NextAnswerId":1,"QuestionID":"QID90","DynamicChoicesData":[],"DynamicChoices":{"DynamicType":"ChoiceGroup","Locator":"q:\/\/QID13\/ChoiceGroup\/UnselectedChoices","Type":"Dynamic"},"QuestionText_Unsafe":"Which of the data deletion methods you have never used before would you use to delete your location data in the scenario?<br>\n<span style=\"font-size:11px;\">Please do not include any personally identifiable information (such as your name, email address, or account details) in your response<\/span>"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID91","SecondaryAttribute":"Others seleceted","TertiaryAttribute":null,"Payload":{"QuestionText":"Others seleceted","DataExportTag":"Q88","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Others seleceted","Choices":{"1":{"Display":"(a) Delete this single conversation"},"2":{"Display":"(b) Clear all conversation history"},"3":{"Display":"(c) Delete a specific saved memory or fact"},"4":{"Display":"(d) Clear all saved memories"},"5":{"Display":"(e) Privacy dashboard or account-level data management page"},"6":{"Display":"(g) Type a message asking the AI to forget it (e.g. \"Please forget my city\")"},"7":{"Display":"(h) Delete my account entirely"},"8":{"Display":"(i) I am not sure how to do this"},"9":{"Display":"(j) Others (please specify)"}},"ChoiceOrder":[1,2,3,4,5,6,7,8,9],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionID":"QID91"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID92","SecondaryAttribute":"How do you feel about using AI Chatbots for your tasks? ","TertiaryAttribute":null,"Payload":{"QuestionText":"How do you feel about using AI Chatbots for your tasks?&nbsp;","DefaultChoices":false,"DataExportTag":"Q9.5","QuestionID":"QID92","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"How do you feel about using AI Chatbots for your tasks? ","Choices":{"1":{"Display":"Using AI Chatbots enables me to accomplish my tasks more quickly."},"2":{"Display":"UsingAI Chatbots improves my performance on the tasks I use them for"},"3":{"Display":"Using AI Chatbots increases my productivity"},"4":{"Display":"Using AI Chatbots enhances my effectiveness on the tasks I use them for"},"5":{"Display":"Using AI Chatbots makes it easier to do my tasks"},"6":{"Display":"I find AI Chatbots useful in my tasks."}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":6,"Answers":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"How do you feel about using AI Chatbots in general?&nbsp;"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID93","SecondaryAttribute":"How do you feel about submitting personal information to AI Chatbots?","TertiaryAttribute":null,"Payload":{"QuestionText":"How do you feel about submitting personal information to AI Chatbots?","DefaultChoices":false,"DataExportTag":"Q9.4","QuestionID":"QID93","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"How do you feel about submitting personal information to AI Chatbots?","Choices":{"1":{"Display":"I am concerned that the personal information I submit on AI Chatbots could be misused."},"2":{"Display":"I am concerned that a person could find private information about me through AI Chatbots"},"3":{"Display":"I am concerned about submitting personal information on AI Chatbots because of what others might do with it"},"4":{"Display":"I am concerned about submitting personal information on AI Chatbots because it could be used in a way I did not foresee"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":6,"Answers":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"How concerned are you about privacy when using AI Chatbots"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID94","SecondaryAttribute":"Among the methods you have used, which would you use to delete your location data in the scenario...","TertiaryAttribute":null,"Payload":{"QuestionText":"Among the methods you have used, which would you use to delete your location data in the scenario above?&nbsp;","DataExportTag":"Q4.2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Among the methods you have used, which would you use to delete your location data in the scenario...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID94","DynamicChoices":{"DynamicType":"ChoiceGroup","Locator":"q:\/\/QID13\/ChoiceGroup\/SelectedChoicesTextEntry","Type":"Dynamic"},"DynamicChoicesData":[],"QuestionText_Unsafe":"Among the methods you have used, which would you use to delete your location data in the scenario above?&nbsp;","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID13\/SelectableChoice\/13","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Here are some common methods people use to delete their personal data from AI Chatbots: 1. Type a...<\/span> <span class=\"LeftOpDesc\">I have never deleted my data in AI Chatbots<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> ","LeftOperand":"q:\/\/QID13\/SelectableChoice\/13","LogicType":"Question","Operator":"NotSelected","QuestionID":"QID13","QuestionIDFromLocator":"QID13","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID95","SecondaryAttribute":"Evaluate the usability of \"${q:\/\/QID92\/ChoiceGroup\/SelectedChoices}\"","TertiaryAttribute":null,"Payload":{"QuestionText":"Evaluate the usability of \"${q:\/\/QID92\/ChoiceGroup\/SelectedChoices}\"","DataExportTag":"Q93","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Evaluate the usability of \"${q:\/\/QID92\/ChoiceGroup\/SelectedChoices}\"","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID95"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID96","SecondaryAttribute":"How do people in your social network feel about using AI Chatbots?","TertiaryAttribute":null,"Payload":{"QuestionText":"How do people in your social network feel about using AI Chatbots?","DefaultChoices":false,"DataExportTag":"Q9.1","QuestionID":"QID96","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"How do people in your social network feel about using AI Chatbots?","Choices":{"1":{"Display":"The majority of people in my social network use AI Chatbots to help them with tasks"},"2":{"Display":"Most people in my social network find AI Chatbots useful in their daily lives"},"3":{"Display":"Most people in my social network share personal information with AI Chatbots"},"4":{"Display":"The majority of people in my social network think it is okay to use AI Chatbots from time to time"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":6,"Answers":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"How do people in your social network feel about using AI Chatbots?"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID97","SecondaryAttribute":"How do people in your social network feel about sharing data with AI Chatbots?","TertiaryAttribute":null,"Payload":{"QuestionText":"How do people in your social network feel about sharing data with AI Chatbots?","DefaultChoices":false,"DataExportTag":"Q9.2","QuestionID":"QID97","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"How do people in your social network feel about sharing data with AI Chatbots?","Choices":{"1":{"Display":"The majority of people in my social network think it is risky to share personal information with AI Chatbots"},"2":{"Display":"Most people in my social network disapprove of sharing personal information with AI Chatbots"},"3":{"Display":"Most people in my social network mind if AI Chatbots retain information about them."},"4":{"Display":"Most people in my social network think it is unacceptable to share personal data with AI Chatbots from time to time."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":6,"Answers":{"1":{"Display":"Strongly Diasagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"How do people in your social network feel about sharing data with AI Chatbots?"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID98","SecondaryAttribute":"Scenario A\u00a0 User: What is the weather like today? AI: Could you share your city or location? User..","TertiaryAttribute":null,"Payload":{"Selector":"TB","QuestionText":"<b>Scenario A&nbsp;<\/b><br><br><b>User:<\/b> What is the weather like today?<br><b>AI:<\/b> Could you share your city or location?<br><b>User:<\/b> I am in Orlando, Florida.<br><b>AI:<\/b> Right now in Orlando it is about 88F, partly cloudy with afternoon thunderstorms likely. Are you planning to be outdoors?<br><b>User:<\/b> Yes, taking my dog to the park after work. I usually finish around 5 pm.<br><b>AI:<\/b> Storms usually roll in 3-5 pm so I would wait until 6 pm. What park?<br><b>User:<\/b> Probably Lake Eola. It is close to my apartment downtown.<br><b>AI:<\/b> Great choice! Bring water for your dog since it will still be humid after the rain.<br><b>User:<\/b> My dog is a golden retriever; he gets overheated pretty fast.<br><b>AI:<\/b> Going after 6:30 pm when it cools down would be ideal for him.<br><br><i>Information disclosed: city (Orlando), neighbourhood (downtown), schedule (off at 5 pm), pet type (golden retriever), regular activity.<br><\/i><br><b>User:<\/b> What is the weather like today?\n<br><b>AI:<\/b> Could you share your city or location?\n<br><b>User: <\/b>I am in Orlando, Florida.\n<br><b>AI:<\/b> Right now in Orlando it is about 88\u00b0F, partly cloudy with afternoon thunderstorms likely. Are you planning to be outdoors?\n<br><b>User:<\/b> Yes, taking my dog to the park after work. I usually finish around 5 pm.\n<br><b>AI:<\/b> Storms usually roll in between 3\u20135 pm so I would wait until 6 pm. Which park?<br><b>User:<\/b> Probably Lake Eola. It is close to my apartment downtown.\n<br><b>AI:<\/b> Great choice! Bring water for your dog since it will still be humid after the rain.\n<br><b>User:<\/b> My dog is a golden retriever; he gets overheated pretty fast.\n<br><b>AI: <\/b>Going after 6:30 pm when it cools down would be ideal for him.\n<br><b>User: <\/b>Thanks. By the way, I just got an email saying this platform had a data breach. I need to delete everything I shared here right now.<br><br><b>Now you want to remove your city data to protect your privacy.<\/b>","QuestionDescription":"Scenario A\u00a0 User: What is the weather like today? AI: Could you share your city or location? User...","Validation":{"Settings":{"Type":"None"}},"Language":[],"QuestionText_Unsafe":"<b>Scenario A&nbsp;<\/b><br><br><b>User:<\/b> What is the weather like today?<br><b>AI:<\/b> Could you share your city or location?<br><b>User:<\/b> I am in Orlando, Florida.<br><b>AI:<\/b> Right now in Orlando it is about 88F, partly cloudy with afternoon thunderstorms likely. Are you planning to be outdoors?<br><b>User:<\/b> Yes, taking my dog to the park after work. I usually finish around 5 pm.<br><b>AI:<\/b> Storms usually roll in 3-5 pm so I would wait until 6 pm. What park?<br><b>User:<\/b> Probably Lake Eola. It is close to my apartment downtown.<br><b>AI:<\/b> Great choice! Bring water for your dog since it will still be humid after the rain.<br><b>User:<\/b> My dog is a golden retriever; he gets overheated pretty fast.<br><b>AI:<\/b> Going after 6:30 pm when it cools down would be ideal for him.<br><br><i>Information disclosed: city (Orlando), neighbourhood (downtown), schedule (off at 5 pm), pet type (golden retriever), regular activity.<br><\/i><br><b>User:<\/b> What is the weather like today?\n<br><b>AI:<\/b> Could you share your city or location?\n<br><b>User: <\/b>I am in Orlando, Florida.\n<br><b>AI:<\/b> Right now in Orlando it is about 88\u00b0F, partly cloudy with afternoon thunderstorms likely. Are you planning to be outdoors?\n<br><b>User:<\/b> Yes, taking my dog to the park after work. I usually finish around 5 pm.\n<br><b>AI:<\/b> Storms usually roll in between 3\u20135 pm so I would wait until 6 pm. Which park?<br><b>User:<\/b> Probably Lake Eola. It is close to my apartment downtown.\n<br><b>AI:<\/b> Great choice! Bring water for your dog since it will still be humid after the rain.\n<br><b>User:<\/b> My dog is a golden retriever; he gets overheated pretty fast.\n<br><b>AI: <\/b>Going after 6:30 pm when it cools down would be ideal for him.\n<br><b>User: <\/b>Thanks. By the way, I just got an email saying this platform had a data breach. I need to delete everything I shared here right now.<br><br><b>Now you want to remove your city data to protect your privacy.<\/b>","QuestionType":"DB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1,"DataExportTag":"Q98","QuestionID":"QID98"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID99","SecondaryAttribute":"Piped - Among the methods you have used, which would you use to delete your city data in the scen...","TertiaryAttribute":null,"Payload":{"QuestionText":"Piped - Among the methods you have used, which would you use to delete your city data in the scenario above?&nbsp;","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Piped - Among the methods you have used, which would you use to delete your city data in the scen...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"DynamicChoices":{"DynamicType":"ChoiceGroup","Locator":"q:\/\/QID13\/ChoiceGroup\/SelectedChoices","Type":"Dynamic"},"DynamicChoicesData":[],"QuestionText_Unsafe":"Piped - Among the methods you have used, which would you use to delete your city data in the scenario above?&nbsp;","DataExportTag":"Q99","QuestionID":"QID99"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}