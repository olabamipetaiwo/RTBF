sponseFlag":"QuotaMet","SurveyTermination":"DefaultMessage","EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=C22U30TZ","EmailThankYou":"false","ResponseSummary":"No","ConfirmResponseSummary":"","CountQuotas":"Yes","Screenout":"No","AnonymizeResponse":"No","IgnoreResponse":"No"},"Logic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID13","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID13\/SelectableChoice\/13","Operator":"Selected","QuestionIDFromLocator":"QID13","LeftOperand":"q:\/\/QID13\/SelectableChoice\/13","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Here are some common methods people use to delete their personal data from AI Chatbots: 1. Type a...<\/span> <span class=\"LeftOpDesc\">I have never deleted my data in AI Chatbots<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression"}}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"RS","PrimaryAttribute":"RS_6Rv4YPTyUCXrJZ4","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[]}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"true","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"Text","PartialData":"+1 month","ValidationMessage":null,"PreviousButton":"","NextButton":"","SkinLibrary":"ucf","SkinType":"MQ","Skin":"ucf1","NewScoring":1,"SurveyTitle":"Right to Be Forgotten in Commercial Large Language Models: A Comparative Audit of Stated Privacy Policies and Real-World Data Handling Practices","SurveyMetaDescription":"Right to Be Forgotten in Commercial Large Language Models: A Comparative Audit of Stated Privacy Policies and Real-World Data Handling Practices","SurveyName":"RTBF","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"No","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]},"ProtectSelectionIds":true}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"User Expectations Survey You are being invited to take part in a research study conducted by rese...","TertiaryAttribute":null,"Payload":{"Selector":"TB","DataExportTag":"CONSENT","QuestionText":"<b>User Expectations Survey<\/b><br><br>You are being invited to take part in a research study conducted by researchers at the University of Central Florida (UCF). Before you decide whether to participate, please read the information below carefully.\nThis study looks at how people who use AI chat tools, such as Claude, ChatGPT, Gemini, and Microsoft Copilot, understand their right to delete their personal data. Many of these tools store your conversations and personal information. Laws such as the General Data Protection Regulation (GDPR) in Europe and the California Consumer Privacy Act (CCPA) in the United States give people the right to request that companies delete their data. This is sometimes called the Right to Be Forgotten (RTBF). <br><br>We want to understand whether users know about this right, how they try to use it, and whether they believe it works the way they expect.\nYou will be asked to answer questions about how you use AI platforms, whether you have ever tried to delete your data, and what you expect to happen when you do. Some questions will show you images of platform screens to help you identify features you may have seen before. The survey takes approximately 12 to 15 minutes to complete.\n<br><br>The risks of taking part in this study are minimal. You may be asked to recall experiences with AI platforms that felt uncomfortable or unsatisfying. You are free to skip any question that makes you uncomfortable or to stop the survey at any time.\nYou will not receive a direct personal benefit from taking part. However, your responses will help researchers understand gaps between what these platforms promise and what they actually do, which may inform better privacy protections for all users.<br><br>This survey is anonymous. We will not collect your name, email address, or any information that could be used to identify you. Your responses will be stored securely on a password-protected document accessible only to the research team. We will not sell or share your data with third parties. De-identified data may be used in future research or academic publications. Note that no internet-based survey can guarantee absolute confidentiality, but we have taken reasonable steps to protect your responses.\nTaking part in this study is completely voluntary. You may choose not to participate, skip any question, or stop at any time without any penalty or consequence. If you have questions about this study, please contact the principal investigator. <br><br>If you have questions about your rights as a research participant, please contact the supervisor\nThis study has not been reviewed and approved by the University of Central Florida Institutional Review Board \nBy continuing to the next page, you confirm that you are 18 years of age or older, that you have read and understood the information above, and that you voluntarily agree to participate in this study.\n<br><br><b>By continuing you confirm you are 18 or older and voluntarily agree to participate.<\/b>","QuestionDescription":"User Expectations Survey You are being invited to take part in a research study conducted by rese...","Validation":{"Settings":{"Type":"None"}},"Language":[],"QuestionID":"QID1","QuestionText_Unsafe":"<b>User Expectations Survey<\/b><br>Right to Be Forgotten in Commercial LLM Platforms<br>A Comparative Audit Study | Claude \u00b7 ChatGPT \u00b7 Gemini \u00b7 Copilot<br><br>This study examines how people understand their right to delete personal data from AI chat tools. Laws such as GDPR (Europe) and CCPA (California) give people the Right to Be Forgotten (RTBF). The survey takes approximately 12-15 minutes. Participation is voluntary and anonymous.<br><br><b>By continuing you confirm you are 18 or older and voluntarily agree to participate.<\/b>","QuestionType":"DB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"Do you believe AI chat platforms are legally required to honour your request to delete your data?","TertiaryAttribute":null,"Payload":{"Selector":"SAVR","DataExportTag":"Q8","QuestionText":"Do you believe AI chat platforms are legally required to honour your request to delete your data?","QuestionDescription":"Do you believe AI chat platforms are legally required to honour your request to delete your data?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID10","QuestionText_Unsafe":"Do you believe AI chat platforms are legally required to honour your request to delete your data?","SubSelector":"TX","Choices":{"1":{"Display":"Yes, I believe they are legally required to"},"2":{"Display":"No, I do not think they are required to"},"3":{"Display":"I am not sure"}},"ChoiceOrder":["1","2","3"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID100","SecondaryAttribute":"Which of the data deletion methods you have never used before would be better for deleting your c...","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of the data deletion methods you have never used before would be better for deleting your city data in the scenario?&nbsp;","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of the data deletion methods you have never used before would be better for deleting your c...","Choices":{"1":{"Display":"None of above would work, I have another method (please specify):","TextEntry":"true"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":2,"NextAnswerId":1,"DynamicChoicesData":[],"DynamicChoices":{"DynamicType":"ChoiceGroup","Locator":"q:\/\/QID13\/ChoiceGroup\/UnselectedChoices","Type":"Dynamic"},"QuestionText_Unsafe":"Which of the data deletion methods you have never used before would be better for deleting your city data in the scenario?&nbsp;","DataExportTag":"Q100","QuestionID":"QID100"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID101","SecondaryAttribute":"Why would you want to use ${q:\/\/QID99\/ChoiceGroup