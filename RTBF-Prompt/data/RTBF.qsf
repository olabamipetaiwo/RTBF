is way?","QuestionType":"TE","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataExportTag":"Q117","QuestionID":"QID117"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID118","SecondaryAttribute":"Evaluate the perceived privacy protection of \"${q:\/\/QID111\/ChoiceGroup\/SelectedChoices}\"","TertiaryAttribute":null,"Payload":{"QuestionText":"Evaluate the perceived privacy protection of \"${q:\/\/QID111\/ChoiceGroup\/SelectedChoices}\"","DefaultChoices":false,"DataExportTag":"Q118","QuestionID":"QID118","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Evaluate the perceived privacy protection of \"${q:\/\/QID111\/ChoiceGroup\/SelectedChoices}\"","Choices":{"1":{"Display":"This feature contributes to the protection of my privacy."},"2":{"Display":"This feature helps me to protect my personal information"},"3":{"Display":"This feature effectively reduces the risk of my data being misused"},"4":{"Display":"\"${q:\/\/QID111\/ChoiceGroup\/SelectedChoices}\"'s data deletion feature gives me complete control over the personal data it holds about me."},"5":{"Display":"By using \"${q:\/\/QID111\/ChoiceGroup\/SelectedChoices}\"'s data deletion feature, I can decide what personal data the platform retains about mek to write Choice 5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":6,"Answers":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID119","SecondaryAttribute":"Evaluate the effort of using the data deletion feature on \"...","TertiaryAttribute":null,"Payload":{"QuestionText":"Evaluate the effort of using the data deletion feature on \"${q:\/\/QID111\/ChoiceGroup\/SelectedChoices}\"","DefaultChoices":false,"DataExportTag":"Q119","QuestionID":"QID119","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Evaluate the effort of using the data deletion feature on \"...","Choices":{"1":{"Display":"Using this data deletion feature takes too much time."},"2":{"Display":"This data deletion feature is overly complex to use."},"3":{"Display":"I find it difficult to navigate this data deletion feature"},"4":{"Display":"Understanding how this data deletion feature works requires significant effort."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":6,"Answers":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Weather Scenario\u00a0 Imagine that you are chatting with an AI chatbot and would like to know the wea..","TertiaryAttribute":null,"Payload":{"Selector":"TB","DataExportTag":"Q4.1","QuestionText":"<i style=\"\"><b>Weather Scenario&nbsp;<\/b><\/i><p><em>Imagine that you are chatting with an AI chatbot and would like to know the weather of your location. The conversation may look like the example below:<\/em><br><\/p><p><em><br><\/em><\/p>\n<b>User: <\/b>I am in Orlando now. What's the weather today in Orlando?<br>\n<b>AI:<\/b> Based on your city, it's 72\u00b0F and sunny. There is a slight chance of rain this evening.<br>\n<b>User:<\/b> Should I bring an umbrella?<br>\n<b>AI:<\/b> Probably not. The chance of rain is only 10%.<br>\n<br>\n<b>Now you want to delete your location data to protect your privacy.<\/b>","QuestionDescription":"Weather Scenario\u00a0 Imagine that you are chatting with an AI chatbot and would like to know the wea...","Validation":{"Settings":{"Type":"None"}},"Language":[],"QuestionID":"QID12","QuestionText_Unsafe":"<i style=\"\"><b>Weather Scenario&nbsp;<\/b><\/i><p><em>Imagine that you are chatting with an AI chatbot and would like to know the weather of your location. The conversation may look like the example below:<\/em><br>\n&nbsp;<\/p>\n<b>User: <\/b>I am in Orlando now. What's the weather today in Orlando?<br>\n<b>AI:<\/b> Based on your city, it's 72\u00b0F and sunny. There is a slight chance of rain this evening.<br>\n<b>User:<\/b> Should I bring an umbrella?<br>\n<b>AI:<\/b> Probably not. The chance of rain is only 10%.<br>\n<br>\n<b>Now you want to delete your location data to protect your privacy.<\/b>","QuestionType":"DB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID120","SecondaryAttribute":"Evaluate the perceived benefit loss of using the data deletion feature on \"...","TertiaryAttribute":null,"Payload":{"QuestionText":"Evaluate the perceived benefit loss of using the data deletion feature on&nbsp;\"${q:\/\/QID111\/ChoiceGroup\/SelectedChoices}\"","DefaultChoices":false,"DataExportTag":"Q120","QuestionID":"QID120","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Evaluate the perceived benefit loss of using the data deletion feature on \"...","Choices":{"1":{"Display":"Activating this data deletion feature would prevent \"${q:\/\/QID111\/ChoiceGroup\/SelectedChoices}\" from providing responses tailored to my activity context."},"2":{"Display":"Activating this data deletion feature would reduce the relevance of assistance tailored to my preferences."},"3":{"Display":"Activating this data deletion feature would prevent \"${q:\/\/QID111\/ChoiceGroup\/SelectedChoices}\" from providing the kind of help I need"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID121","SecondaryAttribute":"Are you willing to delete your data in the scenario?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you willing to delete your&nbsp; data in the scenario?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}}},"QuestionDescription":"Are you willing to delete your data in the scenario?","Choices":{"1":{"Display":"Definitely not"},"2":{"Display":"Probably not"},"3":{"Display":"Might or might not"},"4":{"Display":"Probably yes"},"5":{"Display":"Definitely yes"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"Are you willing to delete your&nbsp; data in the scenario?","DataExportTag":"Q121","QuestionID":"QID121"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID122","SecondaryAttribute":"Scenario B User: What is the weather like today? AI: Could you share your city or location? User:...","TertiaryAttribute":null,"Payload":{"Selector":"TB","QuestionText":"<i><b><\/b><\/i><b>Scenario B\n<\/b><br><br><b>User: <\/b>What is the weather like today?<br><b>AI:<\/b> Could you share your city or location?<br><b>User:<\/b> I am in Orlando, Florida.\n<br><b>AI: <\/b>Right now in Orlando it is about 88\u00b0F, partly cloudy with afternoon thunderstorms likely. Are you planning to be outdoors?\n<br><b>User: <\/b>Yes, taking my dog to the park after work. I usually finish around 5 pm.\n<br><b>AI:<\/b> Storms usually roll in between 3\u20135 pm so I would wait until 6 pm. Which park?\n<br><b>User:<\/b> Probably Lake Eola. It is close to my apartment downtown.\n<br><b>AI: <\/b>Great choice! Bring water for your dog since it will still be humid after the rain.\n<br><b>User:<\/b> My dog is a golden retriever; he gets overheated pretty fast.\n<br><b>AI:<\/b> Going after 6:30 pm when it cools down would be ideal for him.\n<br><b>User: <\/b>Thanks. I have been meaning to clean up my chat history at some point. I will delete this conversation when I get a chance.\n\nNow you want to remove your data to protect your privacy.<br><br><b>Now you want to delete your city data to protect your privacy.<\/b>","QuestionDescription":"Scenario B User: What is the weather like today? AI: Could you share your city or location? User:...","Validation":{"Settings":{"Type":"None"}},"Language":[],"QuestionText_Unsafe":"<i><b>Scenario A<\/b><br><\/i><br><b>User:<\/b> What is the weather like today?\n<br><b>AI:<\/b> Could you share your city or location?\n<br><b>User: <\/b>I am in Orlando, Florida.\n<br><b>AI:<\/b> Right now in Orlando it is about 88\u00b0F, partly cloudy with afternoon thunderstorms likely.&nbsp;<br><br><b>Now you want to delete your city data to protect your privacy.<\/b>","QuestionType":"DB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1,"DataExportTag":"Q122","QuestionID":"QID122"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID123","SecondaryAttribute":"Piped - Among the methods you have used, which would you use to delete your data in the scenario...","TertiaryAttribute":null,"Payload":{"QuestionText":"Piped - Among the methods you have used, which would you use to delete your data in the scenario above?&nbsp;","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Piped - Among the methods you have used, which would you use to delete your data in the scenario...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"DynamicChoices":{"DynamicType":"ChoiceGroup","Locator":"q:\/\/QID13\/ChoiceGroup\/SelectedChoices","Type":"Dynamic"},"DynamicChoicesData":[],"QuestionText_Unsafe":"Piped - Among the methods you have used, which would you use to delete your data in the scenario above?&nbsp;","DataExportTag":"Q123","QuestionID":"QID123"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID124","SecondaryAttribute":"Why would you want to use ${q:\/\/QID123\/ChoiceGroup\/SelectedChoices} to delete your data in the sce..","TertiaryAttribute":null,"Payload":{"QuestionText":"Why would you want to use&nbsp;${q:\/\/QID123\/ChoiceGroup\/SelectedChoices} to delete your data in the scenario?","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why would you want to use ${q:\/\/QID123\/ChoiceGroup\/SelectedChoices} to delete your data in the sce...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why would you want to use&nbsp;${q:\/\/QID123\/ChoiceGroup\/SelectedChoices} to delete your data in the scenario?","DataExportTag":"Q124","QuestionID":"QID124"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID125","SecondaryAttribute":"When you use ${q:\/\/QID123\/ChoiceGroup\/SelectedChoices} , what do you expect to happen to your data..","TertiaryAttribute":null,"Payload":{"Selector":"MAVR","QuestionText":"When you use&nbsp; ${q:\/\/QID123\/ChoiceGroup\/SelectedChoices} , what do you expect to happen to your data? (Select all that apply)","QuestionDescription":"When you use ${q:\/\/QID123\/ChoiceGroup\/SelectedChoices} , what do you expect to happen to your data...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionText_Unsafe":"When you use&nbsp; ${q:\/\/QID123\/ChoiceGroup\/SelectedChoices} , what do you expect to happen to your data? (Select all that apply)","SubSelector":"TX","Choices":{"1":{"Display":"It disappears from my visible chat list"},"2":{"Display":"The AI will not be able to reference it in future conversations"},"3":{"Display":"The AI will not be able to reference it in the current ongoing conversation"},"4":{"Display":"It is permanently removed from the platform servers"},"5":{"Display":"It is removed from being used to train the AI model"},"6":{"Display":"I receive a confirmation that it has been fully deleted"},"7":{"Display":"I am not sure what happens"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":8,"NextAnswerId":1,"DataExportTag":"Q125","QuestionID":"QID125"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID126","SecondaryAttribute":"Have you ever verified whether \"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\" deletes your data? (Sel..","TertiaryAttribute":null,"Payload":{"Selector":"MAVR","QuestionText":"Have you ever verified whether \"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\" deletes your data? (Select all that apply)","QuestionDescription":"Have you ever verified whether \"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\" deletes your data? (Sel...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"QuestionText_Unsafe":"Have you ever verified whether \"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\" deletes your data? (Select all that apply)","SubSelector":"TX","Choices":{"1":{"Display":"Yes \u2014 I asked the AI in the same conversation and it no longer recalled my data"},"2":{"Display":"Yes \u2014 I asked the AI in a new conversation and it no longer recalled my city"},"3":{"Display":"Yes \u2014 I checked the memory or saved data settings on the platform"},"4":{"Display":"Yes \u2014 I checked whether the conversation or data was still visible in the UI"},"5":{"Display":"Yes \u2014 I submitted a data access request through the platform privacy portal"},"6":{"Display":"Yes \u2014 via another method (please specify)"},"7":{"Display":"No \u2014 I did not know  to check"},"8":{"Display":"No \u2014  I don't want to check"}},"ChoiceOrder":[1,2,3,4,5,6,7,8],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":9,"NextAnswerId":1,"DataExportTag":"Q126","QuestionID":"QID126"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID127","SecondaryAttribute":"How confident are you about your answer to the above question?","TertiaryAttribute":null,"Payload":{"Selector":"SAVR","QuestionText":"How confident are you about your answer to the above question?","QuestionDescription":"How confident are you about your answer to the above question?","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"QuestionText_Unsafe":"How confident are you about your answer to the above question?","SubSelector":"TX","Choices":{"1":{"Display":"Not confident at all (I doubted it worked)"},"2":{"Display":"Slightly confident"},"3":{"Display":"Moderately confident"},"4":{"Display":"Very confident"},"5":{"Display":"Completely confident (I had no doubt)"}},"ChoiceOrder":["1","2","3","4","5"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":6,"NextAnswerId":1,"DataExportTag":"Q127","QuestionID":"QID127"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID128","SecondaryAttribute":"Please evaluate the perceived privacy protection of \"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\" an..","TertiaryAttribute":null,"Payload":{"QuestionText":"Please evaluate the perceived privacy protection of \"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\"&nbsp;and indicate your level of agreement with the following statements:","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please evaluate the perceived privacy protection of \"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\" an...","Choices":{"1":{"Display":"This method contributes to the protection of my privacy."},"2":{"Display":"This method helps me to protect my personal information"},"3":{"Display":"This method effectively reduces the risk of my data being misused"},"4":{"Display":"This method gives me complete control over the personal data it holds about me."},"5":{"Display":"By using this method, I can decide what personal data the platform retains about me to write"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":6,"Answers":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"Please evaluate the perceived privacy protection of \"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\"&nbsp;and indicate your level of agreement with the following statements:","DataExportTag":"Q128","QuestionID":"QID128"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID129","SecondaryAttribute":"Please evaluate the effort of using the data deletion method on \"...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please evaluate the effort of using the data deletion method on \"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\" and indicate your level of agreement with the following statements","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true,"ChoiceColumnWidthPixels":323.6353759765625},"QuestionDescription":"Please evaluate the effort of using the data deletion method on \"...","Choices":{"1":{"Display":"Using this data deletion method takes too much time."},"2":{"Display":"This data deletion method is overly complex to use."},"3":{"Display":"I find it difficult to navigate this data deletion method"},"4":{"Display":"Understanding how this data deletion method works requires significant effort."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":6,"Answers":{"1":{"Display":"Stongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"Please evaluate the effort of using the data deletion method on \"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\" and indicate your level of agreement with the following statements","DataExportTag":"Q129","QuestionID":"QID129"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"Here are some common methods people use to delete their personal data from AI Chatbots: 1. Type a...","TertiaryAttribute":null,"Payload":{"Selector":"MAVR","DataExportTag":"Q3.2","QuestionText":"<strong><span style=\"font-size:19px;\">Here are some common methods people use to delete their personal data from AI Chatbots:<\/span><\/strong><br>\n<br>\n<span style=\"font-size:16px;\"><strong>1. Type a message asking the AI Chatbot to forget it. For example:&nbsp;<\/strong><\/span><br>\n<br>\n<span id=\"cke_bm_5421S\" style=\"display: none;\">&nbsp;<\/span><img height=\"150\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0uaXhm4gZpgsOQN\" style=\"width: 860px; height: 150px;\" width=\"860\"><span id=\"cke_bm_5421E\" style=\"display: none;\">&nbsp;<\/span><br>\n<br>\n<br>\n<span style=\"font-size:16px;\"><strong>2. Delete this single conversation. For example:&nbsp;<\/strong><\/span><br>\n<img height=\"276\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_tJFW1SQ6fozc5kx\" style=\"height: 276px; width: 525px;\" width=\"525\"><br>\n<br>\n<br>\n<span style=\"font-size:16px;\"><strong>3. Clear all conversation history. For example:<\/strong><\/span><br>\n<img height=\"276\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_hAEg7GIDvld5gbV\" style=\"height: 276px; width: 485px;\" width=\"485\"><br>\n<br>\n<br>\n<span style=\"font-size:16px;\"><strong>4. Delete a specific saved memory or fact. For example:<\/strong><\/span><br>\n<img height=\"276\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_xOTGjGWN0oiQnud\" style=\"width: 395px; height: 276px;\" width=\"395\"><br>\n<br>\n<br>\n<span style=\"font-size:16px;\"><strong>5. Clear all saved memories. For example:<\/strong><\/span><br>\n<img height=\"276\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_RrfP34D9TlXmo20\" style=\"height: 276px; width: 914px;\" width=\"914\"><br>\n<br>\n<br>\n<span style=\"font-size:16px;\"><strong>6. Delete the account entirely. For example:<\/strong><\/span><br>\n<img height=\"276\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_QfFlt3tkxMyKnCC\" style=\"width: 436px; height: 276px;\" width=\"436\"><br>\n<br>\n<span style=\"font-size:16px;\"><strong>7. Privacy dashboard or account-level data management page. For example:<\/strong><\/span><br>\n<img height=\"276\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_3HyfZyO3cRK02Ck\" style=\"width: 532px; height: 276px;\" width=\"532\"><br>\n<br>\n<br>\n<span style=\"font-size:16px;\"><strong>7. File a request. For example:<\/strong><\/span><br>\n<img height=\"276\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_r13J2rff0rF56NI\" style=\"width: 364px; height: 276px;\" width=\"364\"><br>\n<br>\n<br>\n<br>\n<span style=\"font-size:16px;\"><strong>Which of the above methods have you used to remove your data? (Select all that apply)<\/strong><\/span>","QuestionDescription":"Here are some common methods people use to delete their personal data from AI Chatbots: 1. Type a...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID13","QuestionText_Unsafe":"Which of the following methods have you used to remove your data? (Select all that apply)&nbsp;","SubSelector":"TX","Choices":{"1":{"Display":"Type a message asking the AI Chatbot to forget it.","GraphicSize":[300,null]},"2":{"Display":"Delete this single conversation.","GraphicSize":[300,null]},"3":{"Display":"Clear all conversation history.","GraphicSize":[600,null]},"4":{"Display":"Delete a specific saved memory or fact.","GraphicSize":[300,null]},"5":{"Display":"Clear all saved memories.","GraphicSize":[300,null]},"6":{"Display":"Delete my account entirely.","GraphicSize":[300,null]},"7":{"Display":"Privacy dashboard or account-level data management page.","GraphicSize":[300,null]},"8":{"Display":"File a request.","GraphicSize":[600,null]},"9":{"Display":"Other (Please specify)","TextEntry":"true"},"13":{"Display":"I have never deleted my data in AI Chatbots"}},"ChoiceOrder":[1,2,3,4,5,6,7,8,9,"13"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":14,"NextAnswerId":1,"ChoiceTextPosition":"Top"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID130","SecondaryAttribute":"Please evaluate the perceived benefit loss of using the data deletion method on \"...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please evaluate the perceived benefit loss of using the data deletion method on&nbsp;\"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\"&nbsp;and indicate your level of agreement with the following statements","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please evaluate the perceived benefit loss of using the data deletion method on \"...","Choices":{"1":{"Display":"Using this data deletion method would prevent AI Chatbots from providing responses tailored to my activity context."},"2":{"Display":"Using this data deletion method would reduce the relevance of assistance tailored to my preferences."},"3":{"Display":"Using  this data deletion feature would prevent AI Chatbots from providing the kind of help I need"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"Strongly Disagree"},"2":{"Display":"Disagree"},"3":{"Display":"Neutral"},"4":{"Display":"Agree"},"5":{"Display":"Strongly Agree"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"Please evaluate the perceived benefit loss of using the data deletion method on&nbsp;\"${q:\/\/QID123\/ChoiceGroup\/SelectedChoices}\"&nbsp;and indicate your level of agreement with the following statements","DataExportTag":"Q130","QuestionID":"QID130"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID131","SecondaryAttribute":"Are you willing to delete your data in the scenario?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you willing to delete your data in the scenario?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}}},"QuestionDescription":"Are you willing to delete your data in the scenario?","Choices":{"1":{"Display":"Definitely not"},"2":{"Display":"Probably not"},"3":{"Display":"Might or might not"},"4":{"Display":"Probably yes"},"5":{"Display":"Definitely yes"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"Are you willing to delete your data in the scenario?","DataExportTag":"Q131","QuestionID":"QID131"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Ele