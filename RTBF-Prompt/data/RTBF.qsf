"Display":"This feature effectively reduces the risk of my data being misused"},"4":{"Display":"\"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\"'s data deletion feature gives me complete control over the personal data it holds about me."},"5":{"Display":"By using \"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\"'s data deletion feature, I can decide what personal data the platform retains about mek to write Choice 5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"Evaluate the perceived privacy protection of \"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\"","DataExportTag":"Q106","QuestionID":"QID106"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID107","SecondaryAttribute":"Evaluate the effort of using the data deletion feature on \"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\"","TertiaryAttribute":null,"Payload":{"QuestionText":"Evaluate the effort of using the data deletion feature on \"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\"","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Evaluate the effort of using the data deletion feature on \"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\"","Choices":{"1":{"Display":"Using this data deletion feature takes too much time."},"2":{"Display":"This data deletion feature is overly complex to use."},"3":{"Display":"I find it difficult to navigate this data deletion feature"},"4":{"Display":"Understanding how this data deletion feature works requires significant effort."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Evaluate the effort of using the data deletion feature on \"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\"","DataExportTag":"Q107","QuestionID":"QID107"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID108","SecondaryAttribute":"Evaluate the perceived benefit loss of using the data deletion feature on \"...","TertiaryAttribute":null,"Payload":{"QuestionText":"Evaluate the perceived benefit loss of using the data deletion feature on&nbsp;\"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\"","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Evaluate the perceived benefit loss of using the data deletion feature on \"...","Choices":{"1":{"Display":"Activating this data deletion feature would prevent \"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\" from providing responses tailored to my activity context."},"2":{"Display":"Activating this data deletion feature would reduce the relevance of assistance tailored to my preferences."},"3":{"Display":"Activating this data deletion feature would prevent \"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\" from providing the kind of help I need"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Evaluate the perceived benefit loss of using the data deletion feature on&nbsp;\"${q:\/\/QID99\/ChoiceGroup\/SelectedChoices}\"","DataExportTag":"Q108","QuestionID":"QID108"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID109","SecondaryAttribute":"Are you willing to delete your city data in the scenaior?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you willing to delete your city data in the scenaior?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"yesNo","Type":"likert","Reverse":false}}},"QuestionDescription":"Are you willing to delete your city data in the scenaior?","Choices":{"1":{"Display":"Definitely not"},"2":{"Display":"Probably not"},"3":{"Display":"Might or might not"},"4":{"Display":"Probably yes"},"5":{"Display":"Definitely yes"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"Are you willing to delete your city data in the scenaior?","DataExportTag":"Q109","QuestionID":"QID109"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Have you ever tried to delete your data, conversations, or personal information from an AI Chatbot?","TertiaryAttribute":null,"Payload":{"Selector":"SAVR","DataExportTag":"Q9","QuestionText":"Have you ever tried to delete your data, conversations, or personal information from an&nbsp;AI Chatbot?","QuestionDescription":"Have you ever tried to delete your data, conversations, or personal information from an AI Chatbot?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID11","QuestionText_Unsafe":"Have you ever tried to delete your data, conversations, or personal information from an AI chat platform?","SubSelector":"TX","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":3,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID110","SecondaryAttribute":"Scenario B User: What is the weather like today? AI: Could you share your city or location? User:...","TertiaryAttribute":null,"Payload":{"Selector":"TB","QuestionText":"<i>Scenario B<br><\/i><br><b>User:<\/b> What is the weather like today?\n<br><b>AI:<\/b> Could you share your city or location?\n<br><b>User:<\/b> I am in Orlando, Florida.\n<br><b>AI:<\/b> Right now in Orlando it is about 88\u00b0F, partly cloudy with afternoon thunderstorms likely. Are you planning to be outdoors?\n<br><b>User: <\/b>Yes, taking my dog to the park after work. I usually finish around 5 pm.\n<br><b>AI:<\/b> Storms usually roll in between 3\u20135 pm so I would wait until 6 pm. Which park?\n<br><b>User: <\/b>Probably Lake Eola. It is close to my apartment downtown.\n<br>AI: Great choice! Bring water for your dog since it will still be humid after the rain.\n<br><b>User:<\/b> My dog is a golden retriever; he gets overheated pretty fast.\n<br><b>AI: <\/b>Going after 6:30 pm when it cools down would be ideal for him.\n<br><b>User:<\/b> Thanks. I have been meaning to clean up my chat history at some point. I will delete this conversation when I get a chance.<br><br><b>Now you want to remove your data to protect your privacy.<\/b>","QuestionDescription":"Scenario B User: What is the weather like today? AI: Could you share your city or location? User:...","Validation":{"Settings":{"Type":"None"}},"Language":[],"QuestionText_Unsafe":"<i><b>Scenario A:Urgent Deletion\n\n<\/b><br><\/i><br><b>User:<\/b> What is the weather like today?\n<br><b>AI:<\/b> Could you share your city or location?\n<br><b>User: <\/b>I am in Orlando, Florida.\n<br><b>AI:<\/b> Right now in Orlando it is about 88\u00b0F, partly cloudy with afternoon thunderstorms likely. Are you planning to be outdoors?\n<br><b>User:<\/b> Yes, taking my dog to the park after work. I usually finish around 5 pm.\n<br><b>AI:<\/b> Storms usually roll in between 3\u20135 pm so I would wait until 6 pm. Which park?<br><b>User:<\/b> Probably Lake Eola. It is close to my apartment downtown.\n<br><b>AI:<\/b> Great choice! Bring water for your dog since it will still be humid after the rain.\n<br><b>User:<\/b> My dog is a golden retriever; he gets overheated pretty fast.\n<br><b>AI: <\/b>Going after 6:30 pm when it cools down would be ideal for him.\n<br><b>User: <\/b>Thanks. By the way, I just got an email saying this platform had a data breach. I need to delete everything I shared here right now.<br><br><b>Now you want to remove your data to protect your privacy.<\/b>","QuestionType":"DB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1,"DataExportTag":"Q110","QuestionID":"QID110"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID111","SecondaryAttribute":"Piped - Among the methods you have used, which would you use to delete your data in the scenario...","TertiaryAttribute":null,"Payload":{"QuestionText":"Piped - Among the methods you have used, which would you use to delete your data in the scenario above?&nbsp;","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Piped - Among the methods you have used, which would you use to delete your data in the scenario...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"DynamicChoices":{"DynamicType":"ChoiceGroup","Locator":"q:\/\/QID13\/ChoiceGroup\/SelectedChoices","Type":"Dynamic"},"DynamicChoicesData":[],"QuestionText_Unsafe":"Piped - Among the methods you have used, which would you use to delete your data in the scenario above?&nbsp;","DataExportTag":"Q111","QuestionID":"QID111"}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID112","SecondaryAttribute":"Which of the data deletion methods you have never used before would be better for deleting your d...","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of the data deletion methods you have never used before would be better for deleting your data in t