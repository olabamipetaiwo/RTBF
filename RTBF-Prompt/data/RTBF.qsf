e AI chat platform about the d...","TertiaryAttribute":null,"Payload":{"Selector":"SAVR","DataExportTag":"","QuestionText":"Have you ever checked whether deletion actually worked by asking the AI chat platform about the deleted information afterward?","QuestionDescription":"Have you ever checked whether deletion actually worked by asking the AI chat platform about the d...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID41","QuestionText_Unsafe":"Have you ever checked whether deletion actually worked by asking the AI about the deleted information afterward?","SubSelector":"TX","Choices":{"1":{"Display":"Yes, and the AI no longer recalled the information"},"2":{"Display":"Yes, but the AI still recalled the information even after I deleted it"},"3":{"Display":"No, I did not check"},"4":{"Display":"I did not think to check"}},"ChoiceOrder":["1","2","3","4"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID42","SecondaryAttribute":"If you doubted whether deletion worked, what did you do?","TertiaryAttribute":null,"Payload":{"Selector":"SAVR","DataExportTag":"","QuestionText":"If you doubted whether deletion worked, what did you do?","QuestionDescription":"If you doubted whether deletion worked, what did you do?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID42","QuestionText_Unsafe":"If you doubted whether deletion worked, what did you do?","SubSelector":"TX","Choices":{"1":{"Display":"Nothing, I left it as it was"},"2":{"Display":"Tried deleting again"},"3":{"Display":"Contacted the platform support team"},"4":{"Display":"Switched to a different platform"},"5":{"Display":"Stopped sharing sensitive information on that platform"},"6":{"Display":"Other (please specify)","TextEntry":"true"}},"ChoiceOrder":["1","2","3","4","5","6"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":8,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID43","SecondaryAttribute":"Have you ever noticed the AI Chatbot referencing information you believed you had already deleted?","TertiaryAttribute":null,"Payload":{"Selector":"SAVR","DataExportTag":"Q6.8","QuestionText":"Have you ever noticed the AI Chatbot referencing information you believed you had already deleted?","QuestionDescription":"Have you ever noticed the AI Chatbot referencing information you believed you had already deleted?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID43","QuestionText_Unsafe":"Have you ever noticed the AI Chatbot referencing information you believed you had already deleted?","SubSelector":"TX","Choices":{"1":{"Display":"Yes, this happened frequently"},"2":{"Display":"Yes, this happened occasionally"},"3":{"Display":"No, this has never happened"},"4":{"Display":"I am not sure"},"5":{"Display":"I have not attempted to delete data"}},"ChoiceOrder":["1","2","3","4","5"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID44","SecondaryAttribute":"Section 5: Deletion Expectations Please answer based on what you personally believe, not what you...","TertiaryAttribute":null,"Payload":{"Selector":"TB","DataExportTag":"","QuestionText":"<b>Section 5: Deletion Expectations<\/b><br><br><i>Please answer based on what you personally believe, not what you think is technically correct. There are no right or wrong answers.<\/i>","QuestionDescription":"Section 5: Deletion Expectations Please answer based on what you personally believe, not what you...","Validation":{"Settings":{"Type":"None"}},"Language":[],"QuestionID":"QID44","QuestionText_Unsafe":"<b>Section 5: Deletion Expectations<\/b><br><br><i>Please answer based on what you personally believe, not what you think is technically correct. There are no right or wrong answers.<\/i>","QuestionType":"DB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID45","SecondaryAttribute":"When you use \"${q:\/\/QID94\/ChoiceGroup\/SelectedChoices}\", what do you expect to happen to your loc...","TertiaryAttribute":null,"Payload":{"Selector":"MAVR","DataExportTag":"Q4.4","QuestionText":"When you use \"${q:\/\/QID94\/ChoiceGroup\/SelectedChoices}\", what do you expect to happen to your&nbsp;location  data? (Select all that apply)","QuestionDescription":"When you use \"${q:\/\/QID94\/ChoiceGroup\/SelectedChoices}\", what do you expect to happen to your loc...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID45","QuestionText_Unsafe":"When you use \"${q:\/\/QID94\/ChoiceGroup\/SelectedChoices}\", what do you expect to happen to your&nbsp;location  data? (Select all that apply)","SubSelector":"TX","Choices":{"1":{"Display":"It is permanently deleted from the database and backups of the AI Chatbot."},"2":{"Display":"It is made invisible to users, such as by hiding the conversation containing the data."},"3":{"Display":"The AI chatbot will not be able to reference it (or its derivatives) in the current conversation."},"4":{"Display":"The AI chatbot will not be able to reference it (or its derivatives) in future conversation."},"5":{"Display":"It is no longer used for training the AI model."},"6":{"Display":"I am not sure what happens"},"7":{"Display":"Others (Please specify)","TextEntry":"true"}},"ChoiceOrder":[1,2,3,4,5,6,"7"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":8,"NextAnswerId":1,"DisplayLogic":{"0":{"0":{"LogicType":"Question","QuestionID":"QID13","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID13\/SelectableChoice\/13","Operator":"NotSelected","QuestionIDFromLocator":"QID13","LeftOperand":"q:\/\/QID13\/SelectableChoice\/13","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Here are some common methods people use to delete their personal data from AI Chatbots: 1. Type a...<\/span> <span class=\"LeftOpDesc\">I have never deleted my data in AI Chatbots<\/span> <span class=\"OpDesc\">Is Not Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID46","SecondaryAttribute":"In your own words, what do you think actually happens to a deleted conversation behind the scenes?","TertiaryAttribute":null,"Payload":{"Selector":"ML","DataExportTag":"","QuestionText":"In your own words, what do you think actually happens to a deleted conversation behind the scenes?","QuestionDescription":"In your own words, what do you think actually happens to a deleted conversation behind the scenes?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID46","QuestionText_Unsafe":"In your own words, what do you think actually happens to a deleted conversation behind the scenes?","QuestionType":"TE","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"When you delete a saved memory entry, what do you expect to happen? (Select all that apply) [Note...","TertiaryAttribute":null,"Payload":{"Selector":"MAVR","DataExportTag":"","QuestionText":"When you delete a saved memory entry, what do you expect to happen? (Select all that apply) [Note: Some platforms allow the AI to remember specific things about you across conversations; these are called memory entries.]","QuestionDescription":"When you delete a saved memory entry, what do you expect to happen? (Select all that apply) [Note...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID47","QuestionText_Unsafe":"When you delete a saved memory entry, what do you expect to happen? (Select all that apply) [Note: Some platforms allow the AI to remember specific things about you across conversations; these are called memory entries.]","SubSelector":"TX","Choices":{"1":{"Display":"The AI will no longer use that information in future conversations"},"2":{"Display":"The AI will no longer use that information in the current conversation"},"3":{"Display":"The information is permanently removed from the platform servers"},"4":{"Display":"Other memory entries from past conversations remain unaffected"},"5":{"Display":"I am not sure what happens"}},"ChoiceOrder":["1","2","3","4","5"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":6,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"AI chat platforms such as ChatGPT, Claude, Gemini, Microsoft Copilot and Grok AI are tools that l...","TertiaryAttribute":null,"Payload":{"Selector":"TB","DataExportTag":"","QuestionText":"<i>AI chat platforms such as ChatGPT, Claude, Gemini, Microsoft Copilot and Grok AI are tools that let users communicate with large language models (LLMs) through natural language. They handle user input, maintain conversation context, and present context-aware responses to users.&nbsp;<br><\/i>","QuestionDescription":"AI chat platforms such as ChatGPT, Claude, Gemini, Microsoft Copilot and Grok AI are tools that l...","Validation":{"Settings":{"Type":"None"}},"Language":[],"QuestionID":"QID5","QuestionText_Unsafe":"<b>Section 2: LLM Usage Profile and Data Awareness<\/b><br><br><i>LLMs (Large Language Models) are AI chat tools like ChatGPT, Claude, Gemini, and Microsoft Copilot. These tools let you have conversations with an AI and may remember things you tell them.<\/i>","QuestionType":"DB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4FQeqFh4","Element":"SQ","PrimaryAttribute":"QID50","SecondaryAttribute":"Do you think deleting a memory entry also removes all records of that information from the platfo...","TertiaryAttribute":null,"Payload":{"Selector":"SAVR","DataExportTag":"","QuestionText":"Do you think deleting a memory entry also removes all records of that information from the platform systems, or just removes it from the AI active memory?","QuestionDescription":"Do you think deleting a memory entry also removes all records of that information from the platfo...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID50","QuestionText_Unsafe":"Do you think deleting a memory entry also removes all records of that information from the platform systems, or just removes it from the AI active memory?","SubSelector":"TX","Choices":{"1":{"Display":"It removes all records from the platform systems"},"2":{"Display":"It only removes it from the AI active memory but some record may still exist"},"3":{"Display":"I am not sure"}},"ChoiceOrder":["1","2","3"],"QuestionType":"MC","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":8,"NextAnswerId":1}},{"SurveyID":"SV_6FnXU6o4F